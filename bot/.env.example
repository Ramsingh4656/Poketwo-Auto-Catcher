# Discord account configuration
USER_TOKEN=replace_with_your_discord_user_token

# One channel ID, or several as a comma-separated list. Examples:
#   CATCH_CHANNEL_ID=123456789012345678
#   CATCH_CHANNEL_ID=123456789012345678,987654321098765432
CATCH_CHANNEL_ID=replace_with_channel_id

# Bot behavior
AUTOSTART=false
PORT=5000
CNN_CONFIDENCE_THRESHOLD=0.85

# Legacy model fallback (disabled by default; verified ONNX is required)
ALLOW_LEGACY_FALLBACK=false

# Dashboard security/network (password optional; localhost is the safe default)
DASHBOARD_PASSWORD=change_me
DASHBOARD_HOST=127.0.0.1