# Discord account configuration
USER_TOKEN=replace_with_your_discord_user_token
CATCH_CHANNEL_ID=replace_with_channel_id

# Bot behavior
AUTOSTART=false
PORT=5000
CNN_CONFIDENCE_THRESHOLD=0.85

# Dashboard security/network (password optional; localhost is the safe default)
DASHBOARD_PASSWORD=
DASHBOARD_HOST=127.0.0.1
# Optional P2 Assistant user ID; leave blank to disable, or set 854233015475109888 to enable
P2_ASSISTANT_ID=
